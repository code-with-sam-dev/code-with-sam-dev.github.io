---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import {seriesMap, slugify} from '../../lib/posts';

export async function getStaticPaths() {
  const map = await seriesMap();
  return [...map.entries()].map(([name, posts]) => ({
    params: {series: slugify(name)},
    props: {name, posts},
  }));
}

const {name, posts} = Astro.props;
---

<Base
  title={`${name} - Code with Sam`}
  description={`Every episode in the ${name} series, in order, with videos and runnable code.`}
>
  <div class="section-head" data-reveal>
    <p class="eyebrow" style="color:var(--primary)">Series</p>
    <h1>{name}</h1>
    <p style="color:var(--ink-soft)">
      {posts.length} {posts.length === 1 ? 'episode' : 'episodes'}, in order.
      The code builds on itself, so following from the start leaves you with a
      complete system rather than a pile of samples.
    </p>
  </div>

  <ul class="post-list">
    {posts.map((post, i) => <PostCard post={post} delay={i} />)}
  </ul>
</Base>
