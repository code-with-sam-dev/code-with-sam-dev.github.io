---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import ShortsCarousel from '../components/ShortsCarousel.astro';
import OneThingADay from '../components/OneThingADay.astro';
import PostCard from '../components/PostCard.astro';
import {allPosts, seriesMap, slugify} from '../lib/posts';
import {CHANNEL_URL} from '../lib/channel';
import SubscribeButton from '../components/SubscribeButton.astro';
import YouTubeMark from '../components/YouTubeMark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await allPosts();

// The homepage shows a curated handful. Everything else lives in the archive,
// so this page stays the same length whether there are 3 articles or 300.
const LATEST_COUNT = 6;
const latest = posts.slice(0, LATEST_COUNT);
const series = [...(await seriesMap()).entries()];

/*
  STANDALONE EPISODES: a video of its own, belonging to no series.

  Sam, 2026-09-16, looking at the homepage: "who said only videos with series
  appear here... If possible, put them in a seperate category or something on
  the site. Not to leave them out completely."

  He is right that they were under represented. They were never absent, every
  article is in the list below, but the Series band is the part of the page that
  says WHAT THIS CHANNEL COVERS, and a topic with no series was invisible there
  no matter how good it was. A one off deep dive is not a lesser thing than a
  ten part series, so it gets its own band rather than being left to the feed.
*/
const standalone = posts.filter((p) => !p.data.series && p.data.youtube);

// The hero terminal cycles through every article that supplies one, in a
// SHUFFLED order rather than newest first.
//
// Sam, 2026-09-14, looking at the homepage: "it needs to be random than
// following a particular order". Newest first meant the same two or three
// panels led every single visit, so the older topics were effectively
// invisible no matter how good they were, and the panel felt static to anyone
// who came back. Shuffling spreads the exposure across the whole library.
//
// The shuffle happens at BUILD time, so the markup stays deterministic for a
// given deploy and there is no hydration mismatch. Each deploy reorders it,
// and the player already advances through the list once the page is open.
const FALLBACK_SESSION = {
  path: 'kafka-payments',
  lines: [
    '$ docker compose up',
    '$ curl localhost:8080/demo/results',
    '',
    '  Every episode ships with code you can run.',
  ],
};
const shuffle = <T,>(xs: T[]): T[] => {
  const a = [...xs];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};
const heroSessions = shuffle(posts.map((p) => p.data.terminal).filter(Boolean));
const sessions = heroSessions.length > 0 ? heroSessions : [FALLBACK_SESSION];
// Rendered server side so the panel is never empty: without JavaScript, or
// before it runs, the first session simply sits there as it always did.
const first = sessions[0];

---

<Base
  title="Code with Sam - Software Engineering for the AI Era"
  description="Modern software engineering interview preparation. Kafka, Java, Spring, system design and architecture, explained the way interviewers actually expect you to explain them."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow" data-reveal>Interview prep for the AI era</p>

      <h1 data-reveal>
        Answers that hold up<br />
        <span class="accent">under follow-up questions.</span>
      </h1>

      <p class="lede" data-reveal>
        Most explanations sound right until an interviewer pushes. These go one
        level deeper: what the guarantee actually is, where it breaks, and code
        you can run to watch it break for yourself.
      </p>

      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary" href="#articles">Start reading</a>
        <a class="btn btn-ghost" href={CHANNEL_URL} rel="noopener"><YouTubeMark size={20} /> Watch on YouTube</a>
        <SubscribeButton />
      </div>

      <div
        class="terminal"
        data-reveal
        data-delay="1"
        data-terminal
        data-sessions={JSON.stringify(sessions)}
      >
        <div class="terminal-bar">
          <i style="background:#f85149"></i>
          <i style="background:#d29922"></i>
          <i style="background:#3fb950"></i>
          <span class="t" data-terminal-path>{first.path}</span>
        </div>
        <pre><code data-terminal-body>{first.lines.join('\n')}</code></pre>
      </div>
    </div>
  </section>

  <div class="section-head" data-reveal>
    <p class="eyebrow" style="color:var(--primary)">How this works</p>
    <h2>Three things for every topic</h2>
  </div>

  <div class="cards">
    <article class="card" data-reveal>
      <span class="num">01</span>
      <h3>A short video</h3>
      <p>
        The concept explained visually, in a few minutes, with diagrams that
        demonstrate rather than assert.
      </p>
    </article>
    <article class="card" data-reveal data-delay="1">
      <span class="num">02</span>
      <h3>An article that goes deeper</h3>
      <p>
        The follow-up questions the video has no time for, and the trade-offs a
        senior answer is expected to name.
      </p>
    </article>
    <article class="card" data-reveal data-delay="2">
      <span class="num">03</span>
      <h3>Code you can run</h3>
      <p>
        One command with Docker. Watch the concept break, then watch it work.
        No snippets, no missing pieces.
      </p>
    </article>
  </div>

  {
    series.length > 0 && (
      <>
        <div class="section-head" data-reveal>
          <p class="eyebrow" style="color:var(--primary)">Follow along</p>
          <h2>Series</h2>
        </div>
        <div class="cards">
          {series.map(([name, items], i) => (
            <a
              class="card series-card"
              href={`${base}/series/${slugify(name)}`}
              data-reveal
              data-delay={String(Math.min(i, 3))}
            >
              <span class="num">{String(items.length).padStart(2, '0')}</span>
              <h3>{name}</h3>
              <p>
                {items.length} {items.length === 1 ? 'episode' : 'episodes'}.
                The code builds on itself from the first one.
              </p>
            </a>
          ))}
        </div>
      </>
    )
  }

  {
    standalone.length > 0 && (
      <>
        <div class="section-head" data-reveal>
          <p class="eyebrow" style="color:var(--primary)">One video, all the way down</p>
          <h2>Topics taken apart</h2>
        </div>
        {/*
          THE SAME CARD AS THE ARTICLE FEED, poster and all. Sam, 2026-09-16:
          "Topics taken apart needs YouTube preview as well".

          He is right and the first version was inconsistent: these are the
          channel's biggest single videos, and they were the only place on the
          page showing a video with no picture of it. A band that is meant to
          say WHAT THIS CHANNEL COVERS cannot be the one band with no covers.
        */}
        <ul class="post-list">
          {standalone.map((post, i) => <PostCard post={post} delay={i} />)}
        </ul>
      </>
    )
  }

  <div class="section-head list-head" id="articles" data-reveal>
    <div>
      <p class="eyebrow" style="color:var(--primary)">Latest</p>
      <h2>Articles</h2>
    </div>
    {
      posts.length > LATEST_COUNT && (
        <a class="see-all" href={`${base}/articles`}>
          All {posts.length} articles <span class="arrow">&rarr;</span>
        </a>
      )
    }
  </div>

  <ul class="post-list">
    {latest.map((post, i) => <PostCard post={post} delay={i} />)}
  </ul>

  {posts.length === 0 && <p><em>First article lands with episode one.</em></p>}

  <div data-reveal>
    <ShortsCarousel />

    <OneThingADay />

    <Signup />
  </div>
  <script src="../lib/terminal.player.ts"></script>
</Base>
