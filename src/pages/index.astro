---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'});
---

<Base
  title="Code with Sam — Interview Prep for the AI Era"
  description="Modern software engineering interview preparation. Kafka, Java, Spring, system design and architecture — explained the way interviewers actually expect you to explain them."
>
  <h1>Interview prep for the AI era</h1>
  <p>
    What senior backend engineers are actually asked now — Kafka, Spring,
    system design, architecture trade-offs — explained clearly, with a video
    and runnable code for every topic.
  </p>

  <Signup />

  <h2>Articles</h2>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <h2>
            <a href={`${base}/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <div class="meta">
            <span>{fmt(post.data.pubDate)}</span>
            {post.data.youtube && <span class="tag">video</span>}
            {post.data.repo && <span class="tag">code</span>}
            {post.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p><em>First article lands with episode one.</em></p>}
</Base>
