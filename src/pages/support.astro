---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import {CHANNEL_URL} from '../lib/channel';
import {DONATION_METHODS} from '../lib/support';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const GITHUB = 'https://github.com/code-with-sam-dev';
---

<Base
  title="Support - Code with Sam"
  description="Ways to support Code with Sam, most of which cost nothing."
>
  <h1>Support the channel</h1>
  <p class="lede">
    Every episode takes real work to research, verify and put together: the
    explanation has to be correct, the code has to actually run, and the whole
    thing has to be clear enough to be worth your time. All of it is free, with
    no paywall and no gated newsletter. If it has saved you time, here is how to
    help it keep going.
  </p>

  <h2>Free ways to help</h2>
  <p>
    None of these cost anything, and right now they matter more than money
    does.
  </p>

  <ul class="support-list">
    <li>
      <span class="n">1</span>
      <div>
        <h3><a href={CHANNEL_URL} rel="noopener">Subscribe on YouTube</a></h3>
        <p>
          It is the difference between an episode reaching people who are
          already searching for it and reaching everyone else.
        </p>
      </div>
    </li>
    <li>
      <span class="n">2</span>
      <div>
        <h3>Watch to the end, and comment</h3>
        <p>
          Both help an episode reach other engineers far more than a like does.
          And if you have hit this in production, say so. It tells me what to
          cover next.
        </p>
      </div>
    </li>
    <li>
      <span class="n">3</span>
      <div>
        <h3><a href={GITHUB} rel="noopener">Star the repositories</a></h3>
        <p>
          Stars are how other engineers find the code.
        </p>
      </div>
    </li>
    <li>
      <span class="n">4</span>
      <div>
        <h3>Send one episode to one person</h3>
        <p>
          One share to someone who needed it beats a hundred impressions to
          people who did not.
        </p>
      </div>
    </li>
  </ul>

  {
    DONATION_METHODS.length > 0 ? (
      <>
        <h2>Contribute directly</h2>
        <p>
          Entirely optional, and nothing on this site is ever locked behind it.
        </p>
        <div class="cards">
          {DONATION_METHODS.map((m) => (
            <a class="card" href={m.url} rel="noopener">
              <h3>{m.name}</h3>
              <p>{m.note}</p>
            </a>
          ))}
        </div>
      </>
    ) : (
      <>
        <h2>Contributing directly</h2>
        <p>
          Not open yet. When it is, it will be here. In the meantime the four
          things above help more anyway.
        </p>
        <p>
          If you represent a company and want to talk about sponsorship, that
          has <a href={`${base}/sponsor`}>its own page</a>.
        </p>
      </>
    )
  }

  <h2>Work with me</h2>
  <p>
    The repositories on this site are a working sample of how I build. For
    consulting, contract work or sponsorship, use the
    <a href={`${base}/contact`}>contact form</a>.
  </p>

  <Signup compact />
</Base>
