---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map((post) => ({params: {slug: post.slug}, props: {post}}));
}

const {post} = Astro.props;
const {Content} = await post.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'});

/**
 * "Watch next" — every article points at another one.
 *
 * This is the cheapest view-per-article lever there is: a reader who finishes
 * something and finds nothing to do next simply leaves. Picking the two most
 * recent OTHER posts means it stays populated automatically as the library
 * grows, with no per-article maintenance.
 */
const others = (await getCollection('blog', ({data}) => !data.draft))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const CHANNEL_URL = 'https://www.youtube.com/@CodeWithSam';
---

<Base title={`${post.data.title} — Code with Sam`} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <span>{fmt(post.data.pubDate)}</span>
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    {
      post.data.youtube && (
        <div class="video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${post.data.youtube}`}
            title={post.data.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    {
      post.data.repo && (
        <a class="repo-card" href={post.data.repo} rel="noopener">
          <span>Run this yourself →</span>
          <span class="hint">
            Clone the repo, <code>docker compose up</code>, and watch it happen
          </span>
        </a>
      )
    }

    <Content />
  </article>

  <hr />

  <!-- Send the reader somewhere before they think about leaving. -->
  <section>
    <h2>Watch next</h2>
    {
      others.length > 0 ? (
        <ul class="post-list">
          {others.map((p) => (
            <li>
              <h2>
                <a href={`${base}/blog/${p.slug}`}>{p.data.title}</a>
              </h2>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          More episodes are on the way. The fastest way to catch them is on{' '}
          <a href={CHANNEL_URL} rel="noopener">the YouTube channel</a>.
        </p>
      )
    }
    <p>
      New videos land on <a href={CHANNEL_URL} rel="noopener">Code with Sam</a>
      — subscribe there if this was useful.
    </p>
  </section>

  <Signup compact />
</Base>
