---
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import {poster} from '../../lib/posts';
import {CHANNEL_URL} from '../../lib/channel';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map((post) => ({params: {slug: post.slug}, props: {post}}));
}

const {post} = Astro.props;
const {Content} = await post.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'});

/**
 * "Watch next" - every article points at another one.
 *
 * This is the cheapest view-per-article lever there is: a reader who finishes
 * something and finds nothing to do next simply leaves. Picking the two most
 * recent OTHER posts means it stays populated automatically as the library
 * grows, with no per-article maintenance.
 */
const others = (await getCollection('blog', ({data}) => !data.draft))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);


const art = post.data.cover ? poster(post.data.cover) : undefined;
---

<Base title={`${post.data.title} - Code with Sam`} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <span>{fmt(post.data.pubDate)}</span>
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    {
      /*
        Click-to-load player.

        The poster is our own still, so nothing is requested from YouTube until
        the reader actually asks to watch. That keeps the article fast, keeps a
        third party out of a page view that was never a video view, and means
        the block renders identically before the episode is uploaded - only the
        button underneath changes.
      */
      art && (
        <figure class="video-preview">
          <div class="video-shell" data-video={post.data.youtube ?? ''} data-title={post.data.title}>
            <img src={art.full} width="1280" height="720" alt={`Thumbnail for ${post.data.title}`} />
            {post.data.youtube ? (
              <button type="button" class="play-btn" aria-label={`Play: ${post.data.title}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
              </button>
            ) : (
              <span class="play-btn pending" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
              </span>
            )}
            {post.data.duration && <span class="runtime">{post.data.duration}</span>}
          </div>
          <figcaption>
            {post.data.youtube ? (
              <>Watch on <a href={`https://www.youtube.com/watch?v=${post.data.youtube}`} rel="noopener">YouTube</a>, or read on below.</>
            ) : (
              <>The episode is being published to <a href={CHANNEL_URL} rel="noopener">the channel</a>. Subscribe and it will find you. The write-up below stands on its own in the meantime.</>
            )}
          </figcaption>
        </figure>
      )
    }

    {
      post.data.repo && (
        <a class="repo-card" href={post.data.repo} rel="noopener">
          <span>Run this yourself →</span>
          <span class="hint">
            Clone the repo, <code>docker compose up</code>, and watch it happen
          </span>
        </a>
      )
    }

    <Content />
  </article>

  <hr />

  <!-- Send the reader somewhere before they think about leaving. -->
  <section>
    <h2>Watch next</h2>
    {
      others.length > 0 ? (
        <ul class="post-list">
          {others.map((p) => (
            <li>
              <h2>
                <a href={`${base}/blog/${p.slug}`}>
                  {p.data.title}
                  <span class="arrow">&rarr;</span>
                </a>
              </h2>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          More episodes are on the way. The fastest way to catch them is on{' '}
          <a href={CHANNEL_URL} rel="noopener">the YouTube channel</a>.
        </p>
      )
    }
    <p>
      New videos land on <a href={CHANNEL_URL} rel="noopener">Code with Sam</a> - subscribe there if this was useful.
    </p>
  </section>

  <Signup compact />
</Base>

<script>
  /*
    Replace the poster with the real player on click. Nothing here runs, and no
    YouTube resource is fetched, unless the reader presses play.
  */
  document.querySelectorAll('.video-shell').forEach((shell) => {
    const id = shell.getAttribute('data-video');
    if (!id) return;
    shell.querySelector('.play-btn')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src =
        'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      frame.title = shell.getAttribute('data-title') || 'Video';
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      shell.replaceChildren(frame);
    });
  });
</script>
