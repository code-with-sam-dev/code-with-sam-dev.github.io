---
/**
 * Every account the channel owns, as real links.
 *
 * Exists because of a cross-platform audit on 2026-09-11: the accounts were
 * created over several days and anything published early points only at what
 * existed then. The site is the one surface we fully control, so it carries the
 * complete list and everything else can point here.
 */
import {SOCIALS} from '../lib/channel';
import SocialIcon from './SocialIcon.astro';

interface Props {
  /** A heading is right in a footer, wrong when the page already has one. */
  heading?: string;
}
const {heading} = Astro.props;
const platforms = SOCIALS.filter((s) => !s.support);
const support = SOCIALS.filter((s) => s.support);
---

<nav class="socials" aria-label="Code with Sam elsewhere">
  {heading && <h2>{heading}</h2>}
  <ul>
    {
      platforms.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            <SocialIcon name={s.icon} />
            <span class="text">
              <span class="label">{s.label}</span>
              <span class="note">{s.note}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    support.length > 0 && (
      <>
        <h2 class="support-heading">☕ Support Code with Sam</h2>
        <ul class="support">
          {support.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                <SocialIcon name={s.icon} />
                <span class="text">
                  <span class="label">{s.label}</span>
                  <span class="note">{s.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</nav>

<style>
  .socials h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
  }
  .socials ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .support-heading {
    margin-top: 1.25rem !important;
  }
  .socials ul.support {
    grid-template-columns: minmax(0, 22rem);
  }
  .socials a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--hairline, #d8d8d2);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
  }
  .socials a:hover {
    border-color: var(--primary, #5b3ce0);
  }
  .text {
    display: grid;
    gap: 0.1rem;
  }
  .label {
    font-weight: 600;
  }
  .note {
    font-size: 0.82rem;
    opacity: 0.7;
  }
</style>
