---
/**
 * The YouTube play mark, in YouTube red.
 *
 * Sam's rule, 2026-09-12: "remember to make it red, not purple, when asking
 * people to view the full video on YouTube."
 *
 * The house accent is purple, so a YouTube mark drawn in the house colour is
 * the obvious mistake and the wrong one. A viewer recognises the platform by
 * its colour before reading a word, and a purple play button reads as "some
 * app" rather than YouTube. Brand marks keep their owner's colour; the house
 * palette owns everything around them.
 */
interface Props {
  size?: number;
  class?: string;
}
const {size = 20, class: cls = ''} = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={Math.round((size * 20) / 28)}
  viewBox="0 0 28 20"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="#FF0000"
    d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5C28 14.7 28 10 28 10s0-4.7-.6-6.9Z"
  />
  <path fill="#fff" d="M11.2 14.3 18.5 10l-7.3-4.3v8.6Z" />
</svg>
