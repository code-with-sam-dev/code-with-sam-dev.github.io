---
/**
 * The Shorts, one at a time, stepping on by itself.
 *
 * This started as a marquee and Sam rejected it for the right reason: a
 * continuous scroll "is moving too fast", and a viewer cannot read a title
 * that is sliding past. What he asked for instead is a carousel that holds a
 * Short for about five seconds and then steps to the next one, which is the
 * difference between something you can read and something you watch go by.
 *
 * The section's height is still fixed no matter how long the list grows, which
 * was the original reason for a moving band in the first place.
 *
 * PREVIEWS ARE LOCAL. The poster images are cropped to 9:16 and committed to
 * this repo rather than hot-linked from i.ytimg.com, because hot-linking would
 * call Google on every page load for every visitor and make the privacy
 * policy's "nothing is loaded from YouTube until you press play" a lie. The
 * iframe is only created when someone actually presses play.
 */
import {SHORTS, shortUrl, shortPoster, HOLD_MS} from '../lib/shorts';
import YouTubeMark from './YouTubeMark.astro';
---

{
  SHORTS.length > 0 && (
    <section class="shorts" aria-labelledby="shorts-heading" data-hold={HOLD_MS}>
      <div class="shorts-head">
        <h2 id="shorts-heading">
          <YouTubeMark size={20} /> Shorts
        </h2>
        <p>One idea, about a minute each. Press play to watch it here.</p>
      </div>

      <div class="shorts-viewport">
        <ul class="shorts-track">
          {SHORTS.map((s, i) => (
            <li class="shorts-slide" data-index={i} aria-hidden={i === 0 ? undefined : 'true'}>
              <div class="shorts-frame" data-id={s.id} data-title={s.title}>
                <img
                  src={shortPoster(s)}
                  alt=""
                  width="360"
                  height="640"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <button type="button" class="shorts-play" aria-label={`Play: ${s.title}`}>
                  <span class="shorts-play-mark" aria-hidden="true" />
                </button>
              </div>
              <div class="shorts-meta">
                <p class="shorts-title">{s.title}</p>
                <p class="shorts-from">{s.from}</p>
                <a href={shortUrl(s)} rel="noopener" target="_blank" tabindex={i === 0 ? undefined : -1}>
                  Watch on YouTube
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="shorts-controls">
        <button type="button" class="shorts-nav" data-step="-1" aria-label="Previous Short">‹</button>
        <ul class="shorts-dots" role="tablist" aria-label="Choose a Short">
          {SHORTS.map((s, i) => (
            <li role="presentation">
              <button
                type="button"
                role="tab"
                class="shorts-dot"
                data-go={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={s.title}
              />
            </li>
          ))}
        </ul>
        <button type="button" class="shorts-nav" data-step="1" aria-label="Next Short">›</button>
      </div>
    </section>
  )
}

<script>
  /**
   * One carousel, driven by an index.
   *
   * Everything else here is a consequence of two rules: it must never advance
   * while someone is reading or watching, and it must never advance for a
   * reader who asked their system for reduced motion.
   */
  const root = document.querySelector('.shorts') as HTMLElement | null;
  if (root) {
    const track = root.querySelector('.shorts-track') as HTMLElement;
    const slides = [...root.querySelectorAll('.shorts-slide')] as HTMLElement[];
    const dots = [...root.querySelectorAll('.shorts-dot')] as HTMLButtonElement[];
    const hold = Number(root.dataset.hold ?? 5000);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let index = 0;
    let timer: number | undefined;
    // Set once a viewer presses play. An advancing carousel that yanks a
    // playing video off screen is worse than one that never moves.
    let playing = false;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((s, i) => {
        const current = i === index;
        // Hide the off-screen slides from assistive tech and from the tab
        // order, so keyboard focus cannot land on something nobody can see.
        if (current) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a, button').forEach((el) => {
          (el as HTMLElement).tabIndex = current ? 0 : -1;
        });
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (still.matches || playing) return;
      timer = window.setInterval(() => show(index + 1), hold);
    };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.go));
        start();
      }),
    );

    root.querySelectorAll('.shorts-nav').forEach((b) =>
      b.addEventListener('click', () => {
        show(index + Number((b as HTMLElement).dataset.step));
        start();
      }),
    );

    // Click to load. The iframe does not exist until this runs, so a reader who
    // never presses play never contacts YouTube at all.
    root.querySelectorAll('.shorts-play').forEach((b) =>
      b.addEventListener('click', () => {
        const frame = b.closest('.shorts-frame') as HTMLElement;
        const id = frame.dataset.id;
        if (!id) return;
        playing = true;
        stop();
        // A 180px frame is the right size for a poster and far too small to
        // watch anything in. Growing the slide on play is the whole fix: the
        // layout goes vertical, the player takes a readable width, and the
        // carousel stops moving under the viewer.
        root.classList.add('is-playing');
        const el = document.createElement('iframe');
        el.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        el.title = frame.dataset.title ?? 'Short';
        el.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        el.allowFullscreen = true;
        el.loading = 'lazy';
        frame.replaceChildren(el);
        // Nothing else on the slide should still invite a second click.
        root.querySelectorAll('.shorts-play').forEach((other) => {
          (other as HTMLElement).hidden = true;
        });
      }),
    );

    // Pause while a reader is actually engaging with it.
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    // And while the tab is in the background, where it would only burn battery.
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start(),
    );
    still.addEventListener('change', start);

    show(0);
    start();
  }
</script>

<style>
  .shorts {
    margin: 3rem 0;
  }

  .shorts-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .shorts-head p {
    margin: 0 0 1.25rem;
    color: var(--ink-soft, #5b6472);
    font-size: 0.95rem;
  }

  /* The viewport is what keeps the section one Short tall however long the
     list gets. That was the whole point of the original moving band. */
  .shorts-viewport {
    overflow: hidden;
  }

  .shorts-track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shorts-slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Watching state: the player gets real estate, the text moves below it. */
  .shorts.is-playing .shorts-slide {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .shorts.is-playing .shorts-frame {
    width: min(340px, 80vw);
  }

  .shorts.is-playing .shorts-meta {
    text-align: center;
    max-width: 34rem;
  }

  .shorts-frame {
    position: relative;
    flex: 0 0 auto;
    width: 180px;
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    background: #0a0d12;
  }

  .shorts-frame img,
  .shorts-frame iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }

  .shorts-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  /* YouTube red, per the standing rule that the play mark is never purple. */
  .shorts-play-mark {
    width: 54px;
    height: 38px;
    border-radius: 9px;
    background: #ff0000;
    position: relative;
    box-shadow: 0 2px 10px rgb(0 0 0 / 35%);
  }

  .shorts-play-mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent #fff;
  }

  .shorts-play:hover .shorts-play-mark,
  .shorts-play:focus-visible .shorts-play-mark {
    transform: scale(1.08);
  }

  .shorts-title {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .shorts-from {
    margin: 0 0 0.75rem;
    color: var(--ink-soft, #5b6472);
    font-size: 0.9rem;
  }

  .shorts-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .shorts-nav {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--hairline, #e4e4e0);
    background: transparent;
    color: inherit;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .shorts-dots {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shorts-dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--hairline, #d4d4d0);
    cursor: pointer;
  }

  .shorts-dot[aria-selected='true'] {
    background: var(--accent, #d93a3a);
  }

  @media (max-width: 40rem) {
    .shorts-slide {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No auto-advance, and no sliding either. The controls still work, so
       every Short is still reachable, just never without being asked for. */
    .shorts-track {
      transition: none;
    }
  }
</style>
