---
/**
 * The Shorts, rotating in their own band.
 *
 * Sam's ask, 2026-09-12: the Shorts on the site, "in a marquee like so that if
 * they get too many they will be rotating in their own section". The point of
 * the marquee is that the section's height stays fixed as the list grows, so
 * twenty Shorts cost exactly as much page as six do.
 *
 * How the loop works: the track holds the list TWICE and slides left by
 * exactly half its width, then snaps back. Because the second half is
 * pixel-identical to the first, the snap is invisible and there is never a gap
 * at the end. The duplicate is aria-hidden so a screen reader hears the list
 * once.
 *
 * It stops on hover, on keyboard focus, and for anyone who has asked their
 * system for reduced motion. A band that moves forever and cannot be stopped
 * is not a nice touch, it is something a reader cannot use.
 */
import {SHORTS, shortUrl} from '../lib/shorts';
import YouTubeMark from './YouTubeMark.astro';

// Duration scales with the number of items so each Short is on screen for
// about the same time whether there are six or sixty.
const seconds = Math.max(24, SHORTS.length * 7);
---

{
  SHORTS.length > 0 && (
    <section class="shorts-marquee" aria-labelledby="shorts-heading">
      <div class="shorts-head">
        <h2 id="shorts-heading">
          <YouTubeMark size={20} /> Shorts
        </h2>
        <p>One idea, about a minute. The whole episode is linked on each one.</p>
      </div>

      <div class="shorts-viewport">
        <div class="shorts-track" style={`--marquee-seconds: ${seconds}s`}>
          {[false, true].map((isClone) => (
            <ul class="shorts-list" aria-hidden={isClone ? 'true' : undefined}>
              {SHORTS.map((s) => (
                <li>
                  <a href={shortUrl(s)} rel="noopener" target="_blank" tabindex={isClone ? -1 : undefined}>
                    <span class="shorts-title">{s.title}</span>
                    <span class="shorts-from">{s.from}</span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .shorts-marquee {
    margin: 3rem 0;
  }

  .shorts-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
  }

  .shorts-head p {
    margin: 0 0 1rem;
    color: var(--ink-soft, #5b6472);
    font-size: 0.95rem;
  }

  /* The viewport is what fixes the height. The track inside it can be any
     width at all, which is the entire reason this scales to a long list. */
  .shorts-viewport {
    overflow: hidden;
    /* Fade the two ends so cards enter and leave rather than being chopped. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .shorts-track {
    display: flex;
    width: max-content;
    animation: shorts-scroll var(--marquee-seconds, 42s) linear infinite;
  }

  .shorts-viewport:hover .shorts-track,
  .shorts-track:focus-within {
    animation-play-state: paused;
  }

  .shorts-list {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0 0.375rem;
    list-style: none;
  }

  .shorts-list a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 15rem;
    height: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--hairline, #e4e4e0);
    border-radius: 10px;
    background: var(--surface, #fff);
    text-decoration: none;
    color: inherit;
  }

  .shorts-list a:hover,
  .shorts-list a:focus-visible {
    border-color: var(--accent, #d93a3a);
  }

  .shorts-title {
    font-weight: 600;
    line-height: 1.3;
  }

  .shorts-from {
    font-size: 0.8rem;
    color: var(--ink-soft, #5b6472);
  }

  @keyframes shorts-scroll {
    /* Exactly half, because the track is the list twice over. */
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shorts-track {
      animation: none;
    }
    /* With no animation the track would sit frozen with most of it off
       screen, so let it wrap and show everything instead. */
    .shorts-track {
      flex-wrap: wrap;
      width: 100%;
    }
    .shorts-list {
      flex-wrap: wrap;
    }
  }
</style>
