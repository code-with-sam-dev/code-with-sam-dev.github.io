---
/**
 * One small glyph per platform, drawn here rather than copied from each
 * platform's brand kit, in the platform's own colour so it is recognised before
 * its name is read. Same reasoning as YouTubeMark: YouTube is YouTube red.
 *
 * Monochrome platforms (X, TikTok, GitHub) use currentColor so they follow the
 * theme. Every glyph is decorative: the label beside it carries the meaning, so
 * the svg is hidden from assistive technology.
 */
export type IconName =
  | 'youtube' | 'linkedin' | 'x' | 'tiktok' | 'instagram' | 'facebook' | 'github' | 'coffee' | 'sadza';

interface Props {
  name: IconName;
}
const {name} = Astro.props;
---

{name === 'sadza' ? (
  <img
    class="social-icon"
    src="/support/sadza-48.png"
    srcset="/support/sadza-48.png 1x, /support/sadza-96.png 2x"
    width="26"
    height="26"
    alt=""
    aria-hidden="true"
    loading="lazy"
  />
) : (
<svg class="social-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
  {name === 'youtube' && (
    <g>
      <rect x="1.5" y="5" width="21" height="14" rx="4" fill="#FF0000" />
      <path d="M10 9l5 3-5 3z" fill="#FFFFFF" />
    </g>
  )}
  {name === 'linkedin' && (
    <g>
      <rect x="2" y="2" width="20" height="20" rx="4" fill="#0A66C2" />
      <circle cx="7.5" cy="7.5" r="1.6" fill="#FFFFFF" />
      <rect x="6" y="10" width="3" height="8" fill="#FFFFFF" />
      <path d="M11 10h2.8v1.2c.5-.8 1.5-1.4 2.8-1.4 2 0 3.4 1.2 3.4 3.8V18h-3v-4c0-1.1-.5-1.8-1.5-1.8S14 13 14 14v4h-3z" fill="#FFFFFF" />
    </g>
  )}
  {name === 'x' && (
    <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none" />
  )}
  {name === 'tiktok' && (
    <path d="M13 3h3c.3 2.2 1.7 3.6 4 3.9v3c-1.5 0-2.9-.5-4-1.3V15a6 6 0 1 1-6-6v3.1A3 3 0 1 0 13 15z" fill="currentColor" />
  )}
  {name === 'instagram' && (
    <g fill="none" stroke="#E4405F" stroke-width="2.2">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="#E4405F" stroke="none" />
    </g>
  )}
  {name === 'facebook' && (
    <g>
      <circle cx="12" cy="12" r="10.5" fill="#1877F2" />
      <path d="M13.2 21v-6.8h2.3l.4-2.7h-2.7V9.8c0-.8.3-1.3 1.4-1.3H16V6.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.4 1.3-3.4 3.6v1.9H8v2.7h2.4V21z" fill="#FFFFFF" />
    </g>
  )}
  {name === 'github' && (
    <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  )}
  {name === 'coffee' && (
    <g>
      <path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z" fill="#FFDD00" stroke="currentColor" stroke-width="1.6" />
      <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 3.5c-.8 1 .8 1.5 0 2.8M12 3.5c-.8 1 .8 1.5 0 2.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </g>
  )}
</svg>
)}

<style>
  .social-icon {
    flex: none;
    display: block;
  }
</style>
